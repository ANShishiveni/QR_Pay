{
  "name": "nampay-frontend",
  "version": "2.0.0-demo.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "clean:web": "npx expo start --web --clear",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web --output-dir dist --max-workers 2",
    "build:bundles": "expo export --platform all --output-dir dist-native --max-workers 2",
    "postinstall": "node ../scripts/patch-dependencies.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.16",
    "@react-navigation/stack": "^6.4.1",
    "axios": "^1.7.2",
    "babel-preset-expo": "~13.0.0",
    "expo": "~53.0.23",
    "expo-camera": "~16.1.11",
    "expo-crypto": "~14.1.5",
    "expo-file-system": "~18.1.11",
    "expo-image-picker": "~16.1.4",
    "expo-local-authentication": "~16.0.5",
    "expo-secure-store": "~14.2.4",
    "expo-sharing": "~13.1.5",
    "expo-status-bar": "~2.2.3",
    "jsqr": "1.4.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-paper": "^5.12.3",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.14",
    "qrcode": "^1.5.4",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  },
  "private": true,
  "overrides": {
    "metro@0.82.5": {
      "image-size": "2.0.3"
    },
    "@expo/metro-config@0.20.18": {
      "postcss": "8.5.23"
    },
    "query-string@7.1.3": {
      "decode-uri-component": "0.5.1"
    }
  }
}
