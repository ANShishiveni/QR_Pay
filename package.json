{
  "name": "qr-money-transfer",
  "version": "1.0.0",
  "description": "NamPay 2.0 — a simulated QR-payment prototype",
  "main": "index.js",
  "scripts": {
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "client": "npm --prefix frontend start",
    "dev:demo": "NODE_ENV=development DEMO_MODE=true DATABASE_MODE=memory OTP_PROVIDER=mock npm --prefix backend run dev",
    "install-all": "npm ci && npm --prefix backend ci && npm --prefix frontend ci --legacy-peer-deps",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm --prefix backend test -- --runInBand",
    "test:frontend": "npm --prefix frontend test -- --ci",
    "typecheck": "npm --prefix frontend run typecheck",
    "emulators:install": "bash scripts/install-emulators.sh",
    "emulators": "bash scripts/emulators.sh",
    "test:emulators": "bash scripts/emulators.sh exec \"node scripts/emulator-smoke.cjs\""
  },
  "keywords": [
    "qr",
    "money",
    "transfer",
    "namibia",
    "mobile",
    "payment"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
