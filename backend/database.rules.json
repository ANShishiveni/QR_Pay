{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "cards": {
          "$cardId": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid"
          }
        },
        "profile": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },
    "transactions": {
      ".indexOn": ["userId", "timestamp", "type"],
      "$transactionId": {
        ".read": "auth != null && (data.child('userId').val() == auth.uid || data.child('senderEmail').val() == auth.token.email || data.child('receiverEmail').val() == auth.token.email)",
        ".write": "auth != null"
      }
    },
    "paymentRequests": {
      ".indexOn": ["senderId", "status", "expiresAt"],
      "$requestId": {
        ".read": "auth != null && (data.child('senderId').val() == auth.uid || data.child('receiverId').val() == auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('senderId').val() == auth.uid) || data.child('senderId').val() == auth.uid)"
      }
    },
    "otpSessions": {
      ".indexOn": ["userId", "status", "expiresAt"],
      "$sessionId": {
        ".read": "auth != null && data.child('userId').val() == auth.uid",
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() == auth.uid) || data.child('userId').val() == auth.uid)"
      }
    },
    "qr_codes": {
      "$qrId": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('createdBy').val() == auth.uid"
      }
    }
  }
}
