{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "cards": {
          "$cardId": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid"
          }
        },
        "profile": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },
    "transactions": {
      ".indexOn": ["userId", "timestamp", "type"],
      "$transactionId": {
        ".read": "auth != null && (data.child('userId').val() == auth.uid || data.child('senderEmail').val() == auth.token.email || data.child('receiverEmail').val() == auth.token.email)",
        ".write": "auth != null"
      }
    },
    "qr_codes": {
      "$qrId": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('createdBy').val() == auth.uid"
      }
    }
  }
}
