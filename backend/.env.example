# Local disposable simulator; no provider credentials needed.
NODE_ENV=development
DEMO_MODE=true
DATABASE_MODE=memory
OTP_PROVIDER=mock
HOST=127.0.0.1
PORT=3000
ALLOWED_ORIGINS=http://localhost:8081
# Optional private local delivery directories. Keep outside any web root.
# OTP_OUTBOX_DIR=/absolute/private/path/nampay-outbox
# AUTH_OUTBOX_DIR=/absolute/private/path/nampay-outbox
# Local demo signing secrets are generated on startup if omitted. Restarting
# the memory server clears accounts and invalidates its sessions and QR codes.
# Persistent emulator setup is documented in docs/testing/EMULATORS.md.
# Production mock mode and memory storage are intentionally forbidden.
